# RADIA MVP Environment Variables
# Copy to .env and adjust values

# API
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# Database
DATABASE_URL=sqlite:///./data/radia.db

# Ollama
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_FALLBACK_MODEL=qwen3:8b

# Jev-Style fast classifier
JEV_STYLE_HOST=http://jev-style:8001
JEV_STYLE_MODEL=Jev-Style-0.8B-Decision-v3

# Vector DB
CHROMA_PERSIST_DIR=/app/chroma_db

# Security
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000